{
  "name": "paper-stock-control",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev:web": "pnpm --filter @paper-stock/web dev",
    "dev:api": "python -m uvicorn app.main:app --reload --app-dir apps/api --host 0.0.0.0 --port 8000",
    "lint": "pnpm --filter @paper-stock/web lint && python -m ruff check apps/api",
    "typecheck": "pnpm --filter @paper-stock/web typecheck && python -m mypy apps/api/app apps/api/scripts",
    "test": "pnpm --filter @paper-stock/web test && python -m pytest apps/api/tests",
    "build": "pnpm --filter @paper-stock/web build && python -m compileall -q apps/api/app",
    "contracts:generate": "openapi-typescript http://localhost:8000/openapi.json -o packages/api-client/src/schema.d.ts",
    "infra:start": "supabase start",
    "infra:stop": "supabase stop",
    "db:upgrade": "python -m alembic -c apps/api/alembic.ini upgrade head",
    "db:downgrade": "python -m alembic -c apps/api/alembic.ini downgrade -1"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "supabase": "^2.51.0"
  }
}
