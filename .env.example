# Web
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# API
APP_ENV=development
APP_NAME=Paper Stock Control API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key
SUPABASE_STORAGE_BUCKET=label-images
CORS_ORIGINS=http://localhost:5173

# OCR V2: somente no backend; nunca use prefixo VITE_ para esta chave.
LABEL_OCR_ENABLED=false
GOOGLE_VISION_API_KEY=
LABEL_OCR_TIMEOUT_SECONDS=35
LABEL_OCR_DAILY_LIMIT=100
